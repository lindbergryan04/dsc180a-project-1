# ---------------------------------------------------------------------------
# Data: keep datasets out of Git; retain access instructions (data/README.md)
# ---------------------------------------------------------------------------
/data/*
!/data/README.md

# Raw TGLF datasets used by the notebooks (too large for git). Parsed tables
# such as notebooks/sbhatnagar/task2/data/sat3_table.csv are small and stay in git.
notebooks/**/SAT3_dataset/
notebooks/**/scan_db_outside/
notebooks/**/data_d3d/

# Downloaded archives
*.tar.gz
*.zip

